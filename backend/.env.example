PORT=4000
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h

# Real Windows-native EVM local network (Hardhat node)
LEDGER_MODE=ethereum
ETHEREUM_RPC_URL=http://127.0.0.1:8545
ETHEREUM_MNEMONIC=test test test test test test test test test test test junk
ETHEREUM_DEPLOYMENT_PATH=blockchain/deployments/localhost.json

# PostgreSQL
USE_POSTGRES=true
DATABASE_URL=postgresql://pharma:pharma@localhost:5432/pharma_traceability

# IPFS HTTP API
IPFS_API_URL=http://localhost:5001/api/v0
